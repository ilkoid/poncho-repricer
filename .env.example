# poncho-repricer — переменные окружения для локального запуска.
# Скопируй в .env и заполни:  cp .env.example .env
# .env в .gitignore (секреты не попадут в коммит); этот шаблон — нет.
# Имена переменных совместимы с ../poncho-ai/.env.example — значения оттуда же.

# ── PostgreSQL (тот же сервер, что у poncho-ai) ──
export PGHOST='192.168.10.7'
export PGPORT='15432'
export PGUSER='postgres'
export PG_PWD='...'
# Для агентской работы — ТОЛЬКО тестовые БД; продовые действия — вручную.
export PGDATABASE='repricer_data_test'

# ── WB API (значения те же, что в poncho-ai/.env) ──
export WB_API_KEY='...'                     # prices, promotion (чтение)
export WB_API_CONTENT_KEY='...'             # Content API — записи цен
export WB_API_ANALYTICS_AND_PROMO_KEY='...' # аналитика, продвижение

# ── Ozon Seller API (как в poncho-oz) ──
export OZ_CLIENT_ID='...'
export OZ_ADMIN_API_KEY='...'
